{
  "name": "Anilist updater",
  "description": "Met à jour automatiquement Anilist avec les animés regardés sur Crunchyroll et v6.voiranime.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "notifications",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://*.crunchyroll.com/*",
    "https://v6.voiranime.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["script/tokens.json", "confirm.html", "confirm.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://*.crunchyroll.com/*",
        "https://v6.voiranime.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
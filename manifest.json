{
  "name": "Anilist updater",
  "description": "Met à jour automatiquement Anilist avec les animés regardés sur Crunchyroll et v6.voiranime.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "notifications",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://anilist.co/*",
    "https://anilist-api.tritounet.fr/*",
    "https://*.crunchyroll.com/*",
    "https://v6.voiranime.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "anilist-updater@tritounet.fr",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module",
    "scripts": ["src/background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/confirm.html",
        "ui/confirm.js",
        "ui/auth-success.html",
        "ui/auth-success.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "ui/options.html",
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "assets/icons/icon.png",
      "48": "assets/icons/icon.png",
      "128": "assets/icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://*.crunchyroll.com/*",
        "https://v6.voiranime.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
